# ===== AI 代码学习助手 · 环境变量模板 =====
# 使用方法：把本文件复制为 .env.local，并填入你自己的 API Key
#   Windows（PowerShell）：Copy-Item .env.example .env.local
#   或直接在网页右上角「模型设置」里填写 Key，无需配置本文件

# 智谱 AI 开放平台 API Key（默认模型 GLM-4-Flash，注册即送免费额度）
# 获取地址：https://bigmodel.cn/  → 控制台 → API Keys
ZHIPU_API_KEY=

# ===== 可选：覆盖默认模型与接口地址（留空则用内置默认，即上方智谱配置） =====
# 换模型或换服务商只需修改这两个变量，不必改代码
# 示例：LLM_MODEL=glm-4.5-flash
#      LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=
LLM_BASE_URL=
