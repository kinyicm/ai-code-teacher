# 使用国内镜像源，显著加快 npm install（目标用户与评审均在国内）
# 实测：默认 registry.npmjs.org 在国内常出现长时间无响应甚至 ECONNRESET，
# 切换镜像后同一次安装可从数分钟降到数十秒。
# 如需切回官方源：删除本文件，或执行 npm config set registry https://registry.npmjs.org/
registry=https://registry.npmmirror.com

# 依赖已由 package-lock.json 锁定版本，安装结果与源无关，仅影响速度
fund=false
audit=false
# 注意：镜像源不实现 npm 的安全审计接口，因此直接执行 npm audit 会报 NOT_IMPLEMENTED。
# 需要审计时请临时指定官方源：
#   npm audit --registry=https://registry.npmjs.org
